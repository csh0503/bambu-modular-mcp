{
  "id": "tpu_soft_grip",
  "title": "Flexible TPU Soft Grip / Dampener",
  "author": "your-github-handle",
  "tested_on": ["P1S 0.4mm", "A1 0.4mm", "Generic TPU 95A"],
  "source_or_notes": "Example community preset: slow constant extrusion with concentric top/bottom for squishy dampeners.",
  "max_volumetric_speed": 3.8,
  "process": {
    "wall_loops": "3",
    "sparse_infill_pattern": "gyroid",
    "sparse_infill_density": "12%",
    "top_surface_pattern": "concentric",
    "bottom_surface_pattern": "concentric",
    "reduce_crossing_wall": "1"
  },
  "by_nozzle": {
    "0.4": {
      "process": {
        "layer_height": "0.20"
      }
    },
    "0.6": {
      "process": {
        "layer_height": "0.28"
      }
    }
  }
}
